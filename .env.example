# ═══════════════════════════════════════════════════════════════
# TechMarket VZ — Variables de Entorno
# Copiar este archivo como .env.local y rellenar los valores
# NUNCA commitear .env.local al repositorio
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────
# SUPABASE
# Dashboard: https://supabase.com/dashboard
# ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ──────────────────────────────────────────
# PRISMA / DATABASE
# DATABASE_URL: con PgBouncer (para NestJS en producción)
# DIRECT_URL: conexión directa (para migraciones)
# Supabase > Settings > Database
# ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ──────────────────────────────────────────
# CLOUDINARY
# Dashboard: https://cloudinary.com/console
# ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name

# ──────────────────────────────────────────
# TYPESENSE
# Self-hosted en Railway o Typesense Cloud
# ──────────────────────────────────────────
TYPESENSE_HOST=tu-instancia.railway.app
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=tu-admin-api-key
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=tu-search-only-api-key

# ──────────────────────────────────────────
# REDIS
# Upstash para edge (Next.js) | Railway Redis para BullMQ (NestJS)
# ──────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
REDIS_URL=redis://default:PASSWORD@xxxx.railway.app:6379

# ──────────────────────────────────────────
# EMAIL — Resend
# Dashboard: https://resend.com
# ──────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────
# WHATSAPP / SMS
# 360dialog: https://hub.360dialog.com
# Twilio: https://console.twilio.com
# ──────────────────────────────────────────
WHATSAPP_API_KEY=tu-api-key-360dialog-o-twilio
WHATSAPP_PHONE_NUMBER_ID=tu-phone-number-id

# ──────────────────────────────────────────
# CLOUDFLARE TURNSTILE (anti-bot)
# Dashboard: https://dash.cloudflare.com > Turnstile
# ──────────────────────────────────────────
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAA...
CLOUDFLARE_TURNSTILE_SECRET=0x4AAAAAAA...

# ──────────────────────────────────────────
# APP
# ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="TechMarket VZ"
# Secreto para firmar JWT del API (generar con: openssl rand -base64 64)
JWT_SECRET=
# Secreto para firmar códigos de verificación de listings
VERIFICATION_CODE_SECRET=

# ──────────────────────────────────────────
# WEB PUSH (PWA Notifications)
# Generar claves VAPID con: npx web-push generate-vapid-keys
# ──────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@techmarketvz.com

# ──────────────────────────────────────────
# SENTRY (monitoreo de errores)
# Dashboard: https://sentry.io
# ──────────────────────────────────────────
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# ──────────────────────────────────────────
# POSTHOG (analytics)
# Dashboard: https://app.posthog.com
# ──────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
